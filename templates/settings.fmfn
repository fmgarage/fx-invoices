/*	Variable setzen [ $settings ; Wert: inhalt dieser Datei ]

	Erzeugt das Settings-Object

	@version 1.0.0

*/
Let(
	[
		/*	License email
			the $license variable must alreandy be set ('Insert Text' script step) at this point.
		*/
		email = "info@fmgarage.com";


		/*	debug_mode (default: false)
			When true, every call writes a debug folder to the desktop
			(fx-invoices-debug) containing the raw input (invoice JSON,
			settings, PDF/XML), the generated output and the error log
			of the library. Use it during integration or to report a problem.
			When false, the folder is only written if an error occurs.
			Note: the folder contains invoice data — delete it after use.
		*/
		debug_mode = false;


		/*	Field definitions and mappings are updated regularly. FX Invoices checks the update 
			feed once per day (required for licensing, see docs/leistungsbeschreibung.md).
			false = notify only (default)
			true = install updates automatically
		*/
		auto_update = false


	];
	JSONSetElement ( "" ;
		[ "email"; email; JSONString ];
		[ "debug_mode"; debug_mode; JSONBoolean ];
		[ "auto_update"; auto_update; JSONBoolean ];
		[ "_license"; $license; JSONString ]
	)
)
